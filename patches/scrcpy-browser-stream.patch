diff --git a/app/src/ags_stream_sink.c b/app/src/ags_stream_sink.c
new file mode 100644
index 0000000000000000000000000000000000000000..01bacfc1fed3d566f72d44e6ebe8dedae72b6721
--- /dev/null
+++ b/app/src/ags_stream_sink.c
@@ -0,0 +1,188 @@
+#include "ags_stream_sink.h"
+
+#include <errno.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef _WIN32
+# include <fcntl.h>
+# include <io.h>
+#endif
+
+#include "control_msg.h"
+#include "controller.h"
+#include "util/binary.h"
+#include "util/log.h"
+
+#define DOWNCAST(SINK) container_of(SINK, struct sc_ags_stream_sink, packet_sink)
+#define SC_AGSC_HEADER_SIZE 12
+#define SC_VIDEO_PACKET_HEADER_SIZE 12
+#define SC_VIDEO_PTS_MASK ((UINT64_C(1) << 61) - 1)
+#define SC_VIDEO_CONFIG_FLAG (UINT64_C(1) << 62)
+#define SC_VIDEO_KEY_FRAME_FLAG (UINT64_C(1) << 61)
+
+static bool
+write_bytes(const void *data, size_t size) {
+    if (fwrite(data, 1, size, stdout) != size) {
+        LOGE("Could not write AGS browser video stream");
+        return false;
+    }
+    return true;
+}
+
+static bool
+write_session(uint32_t width, uint32_t height, bool client_resized) {
+    uint8_t header[SC_VIDEO_PACKET_HEADER_SIZE] = {0};
+    header[0] = 0x80 | (client_resized ? 1 : 0);
+    sc_write32be(&header[4], width);
+    sc_write32be(&header[8], height);
+    return write_bytes(header, sizeof(header));
+}
+
+static bool
+ags_video_packet_sink_open(struct sc_packet_sink *packet_sink,
+                           const AVCodecParameters *params,
+                           const struct sc_stream_session *session) {
+    (void) params;
+    struct sc_ags_stream_sink *sink = DOWNCAST(packet_sink);
+    (void) sink;
+
+    if (!session || !session->video.width || !session->video.height) {
+        LOGE("Invalid video dimensions for AGS browser stream");
+        return false;
+    }
+
+    uint8_t metadata[SC_AGSC_HEADER_SIZE] = {'A', 'G', 'S', 'C'};
+    sc_write32be(&metadata[4], session->video.width);
+    sc_write32be(&metadata[8], session->video.height);
+    return write_bytes(metadata, sizeof(metadata))
+        && write_session(session->video.width, session->video.height,
+                         session->video.client_resized)
+        && fflush(stdout) == 0;
+}
+
+static void
+ags_video_packet_sink_close(struct sc_packet_sink *packet_sink) {
+    (void) packet_sink;
+    fflush(stdout);
+}
+
+static enum sc_sink_result
+ags_video_packet_sink_push(struct sc_packet_sink *packet_sink,
+                           const AVPacket *packet) {
+    (void) packet_sink;
+    if (packet->size <= 0) {
+        return SC_SINK_KO;
+    }
+
+    uint64_t pts_flags;
+    if (packet->pts == AV_NOPTS_VALUE) {
+        pts_flags = SC_VIDEO_CONFIG_FLAG;
+    } else {
+        pts_flags = (uint64_t) packet->pts & SC_VIDEO_PTS_MASK;
+        if (packet->flags & AV_PKT_FLAG_KEY) {
+            pts_flags |= SC_VIDEO_KEY_FRAME_FLAG;
+        }
+    }
+
+    uint8_t header[SC_VIDEO_PACKET_HEADER_SIZE];
+    sc_write64be(header, pts_flags);
+    sc_write32be(&header[8], (uint32_t) packet->size);
+    if (!write_bytes(header, sizeof(header))
+            || !write_bytes(packet->data, (size_t) packet->size)
+            || fflush(stdout) != 0) {
+        return SC_SINK_KO;
+    }
+    return SC_SINK_OK;
+}
+
+static enum sc_sink_result
+ags_video_packet_sink_push_session(struct sc_packet_sink *packet_sink,
+                                   const struct sc_stream_session *session) {
+    (void) packet_sink;
+    return write_session(session->video.width, session->video.height,
+                         session->video.client_resized)
+        && fflush(stdout) == 0
+         ? SC_SINK_OK : SC_SINK_KO;
+}
+
+static bool
+read_exact(void *data, size_t size) {
+    uint8_t *cursor = data;
+    while (size) {
+        size_t count = fread(cursor, 1, size, stdin);
+        if (!count) {
+            return false;
+        }
+        cursor += count;
+        size -= count;
+    }
+    return true;
+}
+
+static int
+run_input(void *data) {
+    struct sc_ags_stream_sink *sink = data;
+    uint8_t size_bytes[4];
+    for (;;) {
+        if (!read_exact(size_bytes, sizeof(size_bytes))) {
+            return 0;
+        }
+        uint32_t size = sc_read32be(size_bytes);
+        if (!size || size > SC_CONTROL_MSG_MAX_SIZE) {
+            LOGE("Invalid AGS browser control packet size: %" PRIu32, size);
+            return -1;
+        }
+
+        uint8_t *packet = malloc(size);
+        if (!packet) {
+            LOG_OOM();
+            return -1;
+        }
+        bool ok = read_exact(packet, size);
+        if (ok) {
+            ok = sc_controller_push_raw(sink->controller, packet, size);
+        }
+        free(packet);
+        if (!ok) {
+            if (!feof(stdin)) {
+                LOGE("Could not queue AGS browser control packet");
+                return -1;
+            }
+            return 0;
+        }
+    }
+}
+
+void
+sc_ags_stream_sink_init(struct sc_ags_stream_sink *sink) {
+    static const struct sc_packet_sink_ops ops = {
+        .open = ags_video_packet_sink_open,
+        .close = ags_video_packet_sink_close,
+        .push = ags_video_packet_sink_push,
+        .push_session = ags_video_packet_sink_push_session,
+    };
+
+    sink->packet_sink.ops = &ops;
+    sink->controller = NULL;
+    sink->input_started = false;
+
+#ifdef _WIN32
+    _setmode(_fileno(stdin), _O_BINARY);
+    _setmode(_fileno(stdout), _O_BINARY);
+#endif
+}
+
+bool
+sc_ags_stream_sink_start_input(struct sc_ags_stream_sink *sink,
+                               struct sc_controller *controller) {
+    sink->controller = controller;
+    if (!sc_thread_create(&sink->input_thread, run_input, "ags-stream-input",
+                          sink)) {
+        LOGE("Could not start AGS browser control reader");
+        return false;
+    }
+    sink->input_started = true;
+    return true;
+}
