[Unit]
Description=AGS local Android capture bridge
Requires=ags-android-capture.socket
After=ags-android-capture.socket

[Service]
Type=simple
ExecStart=%h/.local/lib/ags-android-capture/ags-android-capture serve --systemd --idle-timeout=60s
Environment=AGS_CAPTURE_ADB=%h/.local/lib/ags-android-capture/adb
Environment=AGS_CAPTURE_SCRCPY=%h/.local/lib/ags-android-capture/scrcpy
Environment=LD_LIBRARY_PATH=%h/.local/lib/ags-android-capture/lib
EnvironmentFile=-%h/.config/ags-android-capture/environment
Restart=no
TimeoutStopSec=5s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.android
ReadOnlyPaths=%h/.local/lib/ags-android-capture
